# ─────────────────────────────────────────────────────────────
# CryptoTraderCommunity — environment variables
# Copy to .env.local for development. Never commit real secrets.
# Every variable is optional for a read-only local run; features that
# need a missing value are disabled with a visible notice, not a crash.
# ─────────────────────────────────────────────────────────────

# Public origin of the site. Used for SIWE domain/URI checks and referral links.
# Dev default: http://localhost:3000
APP_URL=http://localhost:3000

# Postgres connection string (Supabase or any Postgres 15+).
# When empty, an embedded PGlite database is created under ./.data/pglite
# (development and tests only — not for production or multi-process use).
DATABASE_URL=

# Session cookie signing secret. 32+ random bytes, hex or base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; a per-process random value is used in development.
SESSION_SECRET=

# Bootstrap admin wallet (checksummed or lowercase). Gets the ADMIN role on
# first sign-in. Later admin changes go through the audited admin flow.
ADMIN_WALLET_ADDRESS=

# ── Hyperliquid ─────────────────────────────────────────────
# testnet (default) | mainnet
HL_NETWORK=testnet

# EVM chain the wallet must be on for login and Hyperliquid approvals
# (signatureChainId). Hyperliquid itself runs on its own L1 either way.
# Defaults: testnet → 998 (Hyperliquid HyperEVM testnet), mainnet → 42161 (Arbitrum One).
# Supported: 998, 999 (HyperEVM), 421614 (Arbitrum Sepolia), 42161, 11155111 (Ethereum Sepolia).
WALLET_CHAIN_ID=

# Mainnet order placement is refused unless this is exactly "true" AND
# HL_NETWORK=mainnet AND the user re-confirms in the UI.
MAINNET_TRADING_ENABLED=false

# Builder address that receives the additional builder fee (platform-controlled).
# Must hold >= 100 USDC perps account value on the selected network.
# When empty, builder-fee approval and fee-bearing orders are disabled.
BUILDER_ADDRESS=

# Platform-wide cap for a bot's additional builder fee, in tenths of a basis
# point (Hyperliquid's unit: 10 = 1bp = 0.01%). Hyperliquid's perps cap is 100 (0.1%).
PLATFORM_MAX_BUILDER_FEE_TENTHS_BP=50

# Builder fee for manual (non-bot) orders placed through /trade. 0 = no builder fee.
MANUAL_ORDER_BUILDER_FEE_TENTHS_BP=0

# Per-order notional limit for manual orders (USDC).
MAX_MANUAL_ORDER_USD=1000

# 32-byte key (hex) for AES-256-GCM encryption of agent (API) wallet keys.
# Production: load from a KMS/secret manager. When empty, agent wallets and
# server-side order placement are disabled.
AGENT_KEY_ENCRYPTION_KEY=

# ── P2P swap (docs/SWAP.md) ─────────────────────────────────
# testnet (default: Sepolia, BSC testnet, Amoy, Base Sepolia, Robinhood testnet)
# Mainnets need BOTH SWAP_NETWORK=mainnet and SWAP_MAINNET_ENABLED=true —
# only after an external audit of contracts/contracts/CtcP2PSwap.sol.
SWAP_NETWORK=testnet
SWAP_MAINNET_ENABLED=false
# Optional RPC overrides per chain id, e.g. SWAP_RPC_11155111=https://...
