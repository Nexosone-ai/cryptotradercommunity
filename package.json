{
  "name": "cryptotradercommunity",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker:settlement": "tsx --conditions=react-server workers/settlement.ts",
    "check:hl": "tsx scripts/check-hyperliquid.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "contracts:test": "npm --prefix contracts test",
    "contracts:export": "npm --prefix contracts run export",
    "test:chain": "vitest run --config vitest.chain.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fal-ai/client": "^1.10.1",
    "@nktkas/hyperliquid": "^0.33.3",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "lightweight-charts": "^5.2.1",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "viem": "^2.57.7",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.12"
  }
}
